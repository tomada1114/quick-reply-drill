# Copy this file to .env and fill in what you need. Every name below is
# declared in src/server/env.ts, which is the only place this application
# reads process.env; tests/server-env.test.ts fails when the two drift apart.

# Credential for the OpenAI models this application calls. Required for any
# model call: every endpoint that reaches a model is wired to the OpenAI
# adapter in src/server/composition.ts. The application still boots and serves
# every page without it — a request that needs a model answers 500
# ERR_LLM_AUTH instead, which is a failure you can see rather than a server
# that refuses to start.
OPENAI_API_KEY=
